# Apple release configuration
APPLE_DEVELOP_ID=
APP_STORE_CONNECT_ISSUER_ID=

# Your custom Bundle ID for iCloud testing/local development purposes ONLY
#  (optional, defaults to com.miaomiaoxworld.nativetavern)
BUNDLE_ID=com.miaomiaoxworld.nativetavern
# Your registered iCloud Container (setting this automatically enables iCloud)
ICLOUD_CONTAINER_ID=iCloud.com.miaomiaoxworld.nativetavern
# Optional flags:
ENABLE_ICLOUD=true
EXPORT_METHOD=development
SKIP_CLEAN=false

# Google Play & Android configuration
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.miaomiaoxworld.nativetavern
GOOGLE_PLAY_TRACK=production

# Optional Android local build & sideload configuration (uncomment to use):
# PACKAGE_NAME=com.miaomiaoxworld.nativetavern
# ANDROID_KEYSTORE_PATH=
# ANDROID_STORE_PASSWORD=android
# ANDROID_KEY_PASSWORD=android
# ANDROID_KEY_ALIAS=upload
# INSTALL_TO_DEVICE=false


# Cloudflare R2 direct APK distribution
R2_Access_Key=
R2_Secret_Key=
R2_Endpoint=
R2_OBJECT=NativeTavern.apk

# Discord release announcements
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1462633743998255208
DISCORD_WATCH_CHANNEL_IDS=1462698024475295776,1462696892650491904
DISCORD_RELEASE_CHANNEL_ID=1462697210545176659
